# Matrix/Synapse server
NEXT_PUBLIC_MATRIX_URL=https://your-synapse-server.com
NEXT_PUBLIC_HOMESERVER_NAME=your-synapse-server.com

# coturn TURN server (used for WebRTC video calls via Synapse config)
NEXT_PUBLIC_TURN_HOST=your-turn-server-ip-or-domain

# Docker / Traefik deployment
CHAT_DOMAIN=chat.your-domain.com
