# ============================================================
#  chat-app — Environment variables template
#  Copy this file to `.env.local` and fill in your own values:
#      cp .env.example .env.local
#
#  NEXT_PUBLIC_* variables are exposed to the browser at build
#  time. Do NOT put server-only secrets behind that prefix.
# ============================================================

# --- Matrix / Synapse homeserver -----------------------------
# Full URL of your Synapse homeserver (must include https://)
NEXT_PUBLIC_MATRIX_URL=https://matrix.example.com

# Bare domain part of the homeserver (no protocol, no path).
# Used to build Matrix user IDs like @user:example.com
NEXT_PUBLIC_HOMESERVER_NAME=matrix.example.com

# --- Docker / Traefik deployment -----------------------------
# Public domain where the chat UI will be served (used by the
# Traefik labels in docker-compose.yml).
CHAT_DOMAIN=chat.example.com
